# ========================================================
# Hussein Ali English Academy - Environment Variables Template
# ========================================================

# Deployment Base URL
NEXT_PUBLIC_SITE_URL=https://hussein-ali-english.onrender.com

# PostgreSQL Connection String (From your Supabase Project Settings)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase REST API & Storage
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key_here
NEXT_PUBLIC_STORAGE_BUCKET=uploads

# Admin Portal Credentials
ADMIN_EMAIL=admin@husseinali.com
ADMIN_PASSWORD=HusseinAli2026!
ADMIN_SESSION_SECRET=your_random_strong_session_secret_at_least_32_characters
